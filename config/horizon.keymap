#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/unicode.dtsi>

#define DEF 0
#define SYM 1
#define NUM 2
#define FUN 3

&lt {
    tapping-term-ms = <180>;
    flavor = "tap-preferred";
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        function_layer_activation {
            if-layers = <SYM NUM>;
            then-layer = <FUN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC     &kp Q    &kp W    &kp E     &kp R       &kp T                               &kp Y     &kp U     &kp I       &kp O       &kp P     &kp BSPC
                &kp TAB     &kp A    &kp S    &kp D     &kp F       &kp G                               &kp H     &kp J     &kp K       &kp L       &kp SEMI  &kp SQT
                &kp LSHFT   &kp Z    &kp X    &kp C     &kp V       &kp B       &none      &none       &kp N     &kp M     &kp COMMA   &kp DOT     &kp FSLH  &kp ENTER
                &kp LCTRL   &kp LGUI &kp LALT &kp DEL   &mo NUM     &kp SPACE   &kp SPACE   &kp SPACE   &kp SPACE &mo SYM   &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT
            >;
        };

        symbol_layer {
            bindings = <
                &kp RA(GRAVE) &kp EXCL   &kp LS(N2) &kp RA(N3) &kp DLLR  &kp PRCNT                         &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(MINUS)
                &none         &kp EQUAL  &kp MINUS  &kp RA(E)  &kp RA(N4) &kp LS(LBKT)                     &kp RA(N1) &kp ASTRK  &kp RA(LBKT) &kp RA(RBKT) &kp KP_PLUS &kp LS(EQUAL)
                &none         &kp NUBS   &kp LS(NUBS) &kp RA(N2) &none    &none      &none      &none       &kp RA(SQT) &kp RA(BSLH) &kp FSLH &kp DOT     &none      &none
                &trans        &trans     &trans     &trans     &trans   &trans     &trans     &trans       &trans     &trans      &trans   &trans      &trans     &trans
            >;
        };

        num_layer {
            bindings = <
                &kp TILDE      &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                              &kp N6     &kp N7     &kp N8      &kp N9      &kp N0       &kp BSPC
                &kp TAB        &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                              &kp F6     &kp KP_N4  &kp KP_N5   &kp KP_N6   &kp KP_MINUS &kp C_VOL_UP
                &kp KP_NUMLOCK &kp F7     &kp F8     &kp F9     &kp F10    &kp F11     &trans     &trans       &kp F12    &kp KP_N1  &kp KP_N2   &kp KP_N3   &kp KP_PLUS  &kp C_VOL_DN
                &kp LCTRL      &kp INS    &kp LALT   &kp DEL    &trans     &kp SPACE   &trans     &trans       &kp SPACE  &trans     &kp KP_N0   &kp KP_DOT  &kp C_MUTE   &kp C_PLAY
            >;
        };

        function_layer {
            bindings = <
                &soft_off   &kp F1     &kp F2         &kp F3    &kp F4    &kp PSCRN                            &kp SLCK    &kp HOME   &kp PG_DN    &kp PG_UP    &kp END          &bt BT_CLR
                &trans      &kp F5     &kp F6         &kp F7    &kp F8    &kp INS                              &kp CLCK    &kp LEFT   &kp DOWN     &kp UP       &kp RIGHT        &trans
                &trans      &kp F9     &kp F10        &kp F11   &kp F12   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans      &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp PAUSE_BREAK &trans
                &trans      &trans     &studio_unlock &trans    &trans    &trans       &trans       &trans       &trans      &trans     &trans       &trans       &trans          &trans
            >;
        };
    };
};
